<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 默认（浅色）主题。mobile-ui 有 @media (prefers-color-scheme: light)，
         窗口背景 / 系统栏必须跟随系统，否则浅色模式下顶部与底部会露出深色块。
         深色变体见 values-night/themes.xml，由系统按 uiMode 自动选择。 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F5F7FB</item>
        <item name="android:navigationBarColor">#F5F7FB</item>
        <item name="android:windowBackground">#F5F7FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#4F8DFD</item>
    </style>
</resources>
